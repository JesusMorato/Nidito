# Datos PÚBLICOS de conexión a Supabase. Van dentro de la web, no son secretos.
# Lo que protege los datos son las reglas RLS de la base de datos.
#
# Mientras estén vacíos la app enseña una pantalla que explica cómo rellenarlos
# (ver docs/CONFIGURACION-MANUAL.md, punto 1).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
